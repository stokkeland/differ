# DIƒƒER - Apache 2.4 configuration
# Needs "AllowOverride All" for this directory (run check.sh to verify).

DirectoryIndex index.html
Options -Indexes

# Only index.html and client/ are needed by the browser. Block everything else:
#   dot-files and dot-directories (.git, .vscode, .htaccess, .gitignore, ...),
#   content/ (README images), tools/ (deployment scripts), and README.md, LICENSE.
<If "%{REQUEST_URI} =~ m#/\.|/(content|tools)(/|$)|/(README\.md|LICENSE)$#">
    Require all denied
</If>

<IfModule mod_mime.c>
    AddType image/svg+xml .svg
    AddCharset utf-8 .html .css .js
</IfModule>
